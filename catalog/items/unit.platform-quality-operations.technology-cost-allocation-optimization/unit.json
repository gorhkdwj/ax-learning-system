{
  "schema_version": "1.1.0",
  "id": "unit.platform-quality-operations.technology-cost-allocation-optimization",
  "version": "1.0.0",
  "title": "기술비용 할당·이상·최적화",
  "summary": "청구 총액만 보고 제품·환경·owner·사용량·unit economics를 연결하지 못해 비용 이상과 최적화 효과를 검증하지 못하는 문제를 다룹니다. 해결을 위한 정규 카탈로그 역량입니다.",
  "item_type": "practice",
  "taxonomy": {
    "major_domain": "platform-quality-operations",
    "subdomains": [
      "technology-cost-finops"
    ]
  },
  "domain_tags": [
    "technology",
    "cost",
    "allocation",
    "optimization",
    "operations"
  ],
  "capabilities": [
    "합성 cost·usage fixture를 owner·product·environment에 할당하고 이상·forecast·최적화 후보의 품질과 trade-off를 검증합니다."
  ],
  "learning": {
    "outcomes": [
      {
        "id": "outcome.platform-quality-operations.technology-cost-allocation-optimization.d0",
        "statement": "청구액, 사용량, 할당, unit cost, budget·forecast·anomaly와 업무가치를 구분합니다.",
        "target_level": "D0"
      },
      {
        "id": "outcome.platform-quality-operations.technology-cost-allocation-optimization.d2",
        "statement": "합성 cost·usage fixture를 owner·product·environment에 할당하고 이상·forecast·최적화 후보의 품질과 trade-off를 검증합니다.",
        "target_level": "D2"
      }
    ],
    "default_target_level": "D2",
    "maximum_scope_level": "D2",
    "estimated_minutes": 120,
    "scope_expansion_policy": "local simulator·synthetic telemetry·sealed fixture·bounded load와 삭제 가능한 sandbox로 제한하며 실제 production·cloud 권한·고객·개인정보·결제·외부 장애·법적 통제는 제외합니다. 평가별 봉인 safety manifest에 wall_clock_timeout_seconds≤300, max_requests≤10000, max_concurrency≤16, max_retries_per_request≤2, max_fault_injections≤10, max_fixture_bytes≤10485760, record형 입력은 추가로 max_records≤10000, actual_spend=0, allowed_targets=loopback·새 임시 sandbox, abort trigger와 rollback·restore·cleanup invariant를 기록하고 runner가 위반 즉시 중단해야 합니다. 실제 provider 할인·계약·회계정책과 조직별 unit economics는 검증하지 않았습니다."
  },
