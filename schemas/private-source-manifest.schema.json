{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax-learning.local/schemas/private-source-manifest.schema.json",
  "title": "AX Private Source Manifest",
  "description": "선택적 Vault 안의 개인 학습 원천 패키지를 검증하기 위한 일반화된 manifest 스키마입니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "reviewed_at",
    "rights",
    "selection",
    "files"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/semver"
    },
    "id": {
      "type": "string",
      "pattern": "^private-source\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "$ref": "#/$defs/date"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allowed_use",
        "redistribution"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "verified",
            "restricted",
            "public_domain"
          ]
        },
        "allowed_use": {
          "enum": [
            "personal_learning_only",
            "internal_use",
            "public_redistribution"
          ]
        },
        "redistribution": {
          "enum": [
            "prohibited_until_verified",
            "prohibited",
            "permitted_with_conditions",
            "permitted"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_topics",
        "excluded_scope",
        "expected_file_count"
      ],
      "properties": {
        "included_topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^private-file\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "media_kind": {
            "description": "선택 필드이며 미지정 시 document로 해석합니다. 기존 manifest의 하위호환을 위해 필수로 두지 않습니다.",
            "enum": [
              "document",
              "transcript",
              "frame",
              "audio",
              "video"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "page_count": {
            "type": "integer",
            "minimum": 1
          },
          "captured_at_seconds": {
            "description": "frame이 영상의 몇 초 지점인지 사람이 기록한 참고값입니다.",
            "type": "integer",
            "minimum": 0
          },
          "duration_seconds": {
            "description": "audio·video의 재생시간을 사람이 기록한 참고값입니다. 검증기는 파일에서 실제 재생시간을 추출하지 않습니다.",
            "type": "integer",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "media_kind": {
                  "const": "document"
                }
              }
            },
            "then": {
              "required": [
                "page_count"
              ],
              "properties": {
                "path": {
                  "pattern": "\\.pdf$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "media_kind": {
                  "const": "transcript"
                }
              },
              "required": [
                "media_kind"
              ]
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "\\.(vtt|srt|txt|md)$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "media_kind": {
                  "const": "frame"
                }
              },
              "required": [
                "media_kind"
              ]
            },
            "then": {
              "required": [
                "captured_at_seconds"
              ],
              "properties": {
                "path": {
                  "pattern": "\\.(jpg|jpeg|png)$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "media_kind": {
                  "const": "audio"
                }
              },
              "required": [
                "media_kind"
              ]
            },
            "then": {
              "required": [
                "duration_seconds"
              ],
              "properties": {
                "path": {
                  "pattern": "\\.(m4a|mp3|wav)$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "media_kind": {
                  "const": "video"
                }
              },
              "required": [
                "media_kind"
              ]
            },
            "then": {
              "required": [
                "duration_seconds"
              ],
              "properties": {
                "path": {
                  "pattern": "\\.(mp4|webm|mkv)$"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  }
}
