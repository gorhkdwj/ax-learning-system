{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ax-learning.local/schemas/learning-resource.schema.json",
  "title": "AX Learning Resource",
  "description": "챕터·실습·평가·코드·교재 등 개별 학습자료의 메타데이터 스키마입니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "description",
    "resource_type",
    "owner",
    "location",
    "learning_outcome_ids",
    "provenance",
    "accessibility",
    "verification",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/semver"
    },
    "id": {
      "type": "string",
      "pattern": "^resource\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "resource_type": {
      "enum": [
        "article",
        "interactive_html",
        "code",
        "lab",
        "dataset",
        "template",
        "quiz",
        "assessment",
        "textbook",
        "visualization",
        "video",
        "audio",
        "external_reference"
      ]
    },
    "owner": {
      "oneOf": [
        {
          "$ref": "#/$defs/unitOwner"
        },
        {
          "$ref": "#/$defs/setOwner"
        }
      ]
    },
    "location": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "local"
            },
            "path": {
              "type": "string",
              "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      ]
    },
    "learning_outcome_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^outcome\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "type": "string",
      "default": "ko"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "sources"
      ],
      "properties": {
        "origin": {
          "enum": [
            "original",
            "adapted",
            "external"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "license": {
          "type": "string"
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partial",
            "unverified",
            "not_applicable"
          ]
        },
        "standard": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "enum": [
              "keyboard",
              "focus_visible",
              "semantic_structure",
              "text_alternative",
              "captions",
              "reduced_motion",
              "print_alternative"
            ]
          },
          "uniqueItems": true
        },
        "alternative_resource_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceRef"
          }
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "required": [
              "checked_at"
            ]
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partial",
            "unverified",
            "failed",
            "expired"
          ]
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "origin": {
                "enum": [
                  "adapted",
                  "external"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "sources": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "unitOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "const": "unit"
        },
        "id": {
          "type": "string",
          "pattern": "^unit\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "setOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "const": "set"
        },
        "id": {
          "type": "string",
          "pattern": "^set\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^resource\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "network_required": {
          "type": "boolean"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider"
            ],
            "properties": {
              "provider": {
                "type": "string"
              },
              "plan": {
                "type": "string"
              }
            }
          }
        },
        "secret_names": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "access",
              "approval_required",
              "data_class"
            ],
            "properties": {
              "system": {
                "type": "string"
              },
              "access": {
                "enum": [
                  "read",
                  "write",
                  "delete",
                  "admin",
                  "financial"
                ]
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "approval_required": {
                "type": "boolean"
              },
              "data_class": {
                "enum": [
                  "none",
                  "public",
                  "internal",
                  "personal",
                  "sensitive"
                ]
              }
            }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "enum": [
                "free",
                "freemium",
                "fixed",
                "usage_based",
                "unknown"
              ]
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "estimated_amount": {
              "type": "number",
              "minimum": 0
            },
            "basis": {
              "type": "string"
            },
            "pricing_url": {
              "type": "string",
              "format": "uri"
            },
            "checked_at": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "technology_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "constraint"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "constraint": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source_type",
        "url",
        "checked_at"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "source_type": {
          "enum": [
            "standard",
            "official_spec",
            "official_docs",
            "official_source",
            "primary_research",
            "secondary_reference"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_version": {
          "type": "string"
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "last_reviewed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "cataloged",
            "scheduled",
            "active",
            "operational",
            "reference",
            "probe",
            "pilot",
            "scale",
            "deprecated",
            "archived"
          ]
        },
        "owner": {
          "type": "string"
        },
        "last_reviewed_at": {
          "$ref": "#/$defs/date"
        },
        "review_due_at": {
          "$ref": "#/$defs/date"
        },
        "deprecated_at": {
          "$ref": "#/$defs/date"
        },
        "superseded_by": {
          "$ref": "#/$defs/resourceRef"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
